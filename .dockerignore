# Allowlist: secrets, workbook sources, Git, tests and host dependencies stay out.
**
!pyproject.toml
!uv.lock
!apps/
apps/**
!apps/api/
apps/api/**
!apps/api/alembic.ini
!apps/api/altvia/
apps/api/altvia/**
!apps/api/altvia/*.py
!apps/api/migrations/
apps/api/migrations/**
!apps/api/migrations/env.py
!apps/api/migrations/script.py.mako
!apps/api/migrations/versions/
apps/api/migrations/versions/**
!apps/api/migrations/versions/*.py
!scripts/
scripts/**
!scripts/check_api_runtime.py
!infra/
infra/**
!infra/start-postgres.sh
!infra/postgres-runtime-marker.sh
!infra/gosu.go.mod
!infra/gosu.go.sum
!infra/redis-health.sh
!infra/start-redis.sh
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!apps/web/
apps/web/**
!apps/web/package.json
!apps/web/next.config.ts
!apps/web/tsconfig.json
