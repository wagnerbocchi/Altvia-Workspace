# Copy to .env and replace placeholders. Never commit the resulting file.
ALTVIA_DATABASE_URL=postgresql+psycopg://altvia:REPLACE_WITH_SECRET@127.0.0.1:5432/altvia
ALTVIA_PUBLIC_ORIGIN=https://workspace.example.invalid
# Optional private infrastructure uses infra/compose.files.yaml and secret files.
# See docs/runbooks/private-files.md; never put storage credentials in this file.
ALTVIA_STORAGE_IMAGE=altvia-storage:local
ALTVIA_CLAMAV_IMAGE=altvia-clamav:local
