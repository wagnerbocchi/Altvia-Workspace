      "description": "Compact operational action; the ghost preview uses the theme-control foreground.",
      "html": "<button type=\"button\" class=\"ds-button ds-ghost\">Atualizar</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:36px;border:1px solid transparent;border-radius:6px;padding:7px 12px;font-weight:600;cursor:pointer;font-family:\"Segoe UI\", -apple-system, BlinkMacSystemFont, Arial, sans-serif;font-size:14px;line-height:1.5;}.ds-button:focus-visible{outline:2px solid var(--focus,#2866c0);outline-offset:3px;}.ds-button:disabled{cursor:wait;opacity:.65;}.ds-ghost{background:transparent;color:var(--muted,#646464);}.ds-ghost:hover:not(:disabled){background:var(--selected,#eaeae8);}@media(max-width:540px),(pointer:coarse){.ds-button{min-height:44px;}}"
    },
    {
      "name": "Labeled Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Native field with an explicit label and visible invalid/focus states.",
      "html": "<div class=\"ds-field\"><label class=\"ds-label\" for=\"ds-name\">Nome</label><input class=\"ds-input\" id=\"ds-name\" placeholder=\"Nome do registro\"></div>",
      "css": ".ds-field{font-family:\"Segoe UI\", -apple-system, BlinkMacSystemFont, Arial, sans-serif;font-size:14px;line-height:1.5;color:var(--ink,#262626);}.ds-label{display:block;margin-bottom:8px;font-weight:600;}.ds-input{display:block;width:100%;min-height:40px;padding:8px 10px;border:1px solid var(--control-line,#a6a6a3);border-radius:6px;background:var(--surface,#ffffff);color:var(--ink,#262626);font-family:\"Segoe UI\", -apple-system, BlinkMacSystemFont, Arial, sans-serif;font-size:15px;line-height:1.5;caret-color:var(--primary,#245bb2);}.ds-input::placeholder{color:var(--muted,#646464);opacity:1;}.ds-input[aria-invalid=\"true\"]{border-color:var(--error,#a42f3b);}.ds-input:focus-visible{outline:2px solid var(--focus,#2866c0);outline-offset:3px;}@media(max-width:540px),(pointer:coarse){.ds-input{min-height:44px;font-size:16px;}}"
    },
    {
      "name": "Current Destination",
      "kind": "nav",
      "refersTo": "navigation-link",
      "description": "Quiet current context with an inline line icon and real link semantics.",
      "html": "<nav aria-label=\"Navegacao principal\" class=\"ds-nav\"><a class=\"ds-nav-link\" href=\"#ds-work\" aria-current=\"page\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M18 6 7 17l-5-5\"/><path d=\"m22 10-7.5 7.5L13 16\"/></svg><span>Meu trabalho</span></a></nav>",
      "css": ".ds-nav{padding:12px;background:var(--ground,#f7f7f6);}.ds-nav-link{display:flex;align-items:center;gap:10px;min-height:36px;padding:8px 10px;border-radius:5px;color:var(--muted,#646464);font-family:\"Segoe UI\", -apple-system, BlinkMacSystemFont, Arial, sans-serif;font-size:13px;line-height:1.5;text-decoration:none;}.ds-nav-link[aria-current=\"page\"],.ds-nav-link:hover{background:var(--selected,#eaeae8);color:var(--ink,#262626);}.ds-nav-link[aria-current=\"page\"]{font-weight:600;}.ds-nav-link:focus-visible{outline:2px solid var(--focus,#2866c0);outline-offset:3px;}@media(max-width:900px){.ds-nav-link{min-height:44px;font-size:14px;}}"
    },
    {
      "name": "State Chip",
      "kind": "chip",
      "refersTo": "status-chip",
      "description": "Soft explicit state; static metadata rather than an action.",
      "html": "<span class=\"ds-status\">Em andamento</span>",
      "css": ".ds-status{display:inline-flex;align-items:center;max-width:100%;overflow-wrap:anywhere;padding:3px 8px;border-radius:4px;background:var(--notice-ground,#f0f4fa);color:var(--primary,#245bb2);font-family:\"Segoe UI\", -apple-system, BlinkMacSystemFont, Arial, sans-serif;font-size:12px;font-weight:500;line-height:1.5;}"
    },
    {
      "name": "Identity Working Surface",
      "kind": "card",
      "refersTo": "working-surface",
      "description": "Bounded identity state; operational sections use the continuous field.",
      "html": "<section class=\"ds-surface\"><h1 class=\"ds-heading\">Acesse seu workspace</h1><p class=\"ds-intro\">Use sua conta Altvia para entrar.</p></section>",
      "css": ".ds-surface{width:100%;max-width:440px;padding:36px;border:1px solid var(--line,#e1e1df);border-radius:8px;background:var(--surface,#ffffff);color:var(--ink,#262626);font-family:\"Segoe UI\", -apple-system, BlinkMacSystemFont, Arial, sans-serif;font-size:15px;line-height:1.5;}.ds-heading{margin:0 0 10px;font-size:26px;line-height:1.25;font-weight:650;letter-spacing:-.025em;text-wrap:balance;}.ds-intro{margin:0 0 28px;color:var(--muted,#646464);}@media(max-width:540px){.ds-surface{padding:28px 24px;}.ds-heading{font-size:24px;}}@media(max-width:360px){.ds-surface{padding:24px 20px;}}"
    },
    {
      "name": "Session Notice",
      "kind": "custom",
      "refersTo": "notice",
      "description": "Quiet feedback retains explanatory status text.",
      "html": "<p class=\"ds-notice\" role=\"status\">Sua sessao terminou. Entre novamente.</p>",
      "css": ".ds-notice{margin:0 0 20px;padding:12px;border-radius:6px;background:var(--notice-ground,#f0f4fa);color:var(--ink,#262626);overflow-wrap:anywhere;font-family:\"Segoe UI\", -apple-system, BlinkMacSystemFont, Arial, sans-serif;font-size:14px;line-height:1.5;}"
    },
    {
      "name": "Error Message",
      "kind": "custom",
      "refersTo": "error-message",
      "description": "Error explanation remains textual and announced.",
      "html": "<p class=\"ds-error\" role=\"alert\">Nao foi possivel carregar. Tente novamente.</p>",
      "css": ".ds-error{margin:0 0 20px;padding:12px;border-radius:6px;background:var(--error-ground,#fcf0f1);color:var(--error,#a42f3b);overflow-wrap:anywhere;font-family:\"Segoe UI\", -apple-system, BlinkMacSystemFont, Arial, sans-serif;font-size:14px;line-height:1.5;}"
    }
  ],
  "narrative": {
    "northStar": "The Daily Operations Desk",
    "overview": "The Daily Operations Desk makes repeated work legible through a quiet sidebar, a continuous working field and aligned records. The user-selected Twenty CRM reference informs the restraint, density and navigation; Altvia keeps its own name, real capabilities and resource boundaries. This replaces the former navy service-desk wayfinding world.\n\nOffwhite and white planes become neutral charcoal in dark mode. System sans, small line icons and deliberate blue actions keep attention on records and their next action. This is a product UI direction, not approved corporate branding: no corporate logo or typeface was supplied.",
    "keyCharacteristics": [
      "Neutral sidebar and continuous content with shared desktop alignment.",
      "Compact system typography, labeled native fields and line icons.",
      "Blue actions and soft semantic chips with explicit state wording.",
      "Flat section rules, responsive labeled records and deliberate inline recovery."
    ],
    "rules": [
      {
        "name": "The Neutral Context Rule",
        "body": "Use neutral selection for the current destination; reserve blue for actions and the operational states already mapped to it.",
        "section": "colors"
      },
      {
        "name": "The Shared Track Rule",
        "body": "Operational headings, facts, forms and section rules fill the shared content track; bound prose independently.",
        "section": "layout"
      },
      {
        "name": "The Flat Working Field Rule",
        "body": "Separate work with surface tones and hairlines, without decorative shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use semantic light/dark tokens for surfaces, controls, feedback and state.",
      "**Do** align operational headings and section rules on the shared content track while keeping prose readable.",
      "**Do** preserve explicit labels, visible keyboard focus and text alongside state color.",
      "**Do** wrap long records, retain mobile field labels and keep Kanban overflow inside its named region.",
      "**Do** keep exact review, uncertain-result recovery and session-ending confirmations legible beside the action."
    ],
    "donts": [
      "**Don't** restore the former navy masthead or cool-blue page ground.",
      "**Don't** invent metrics, CRM features, imagery or an approved Altvia logo from the reference.",
      "**Don't** replace native semantic controls or named actions with decorative glyphs.",
      "**Don't** turn each operational section into an elevated card or add decorative motion.",
      "**Don't** use a navigation destination, assignment or visual state as an access grant."
    ]
  }
}
