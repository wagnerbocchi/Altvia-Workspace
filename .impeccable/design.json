  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The principal task action, using the semantic action and surface colors.",
      "html": "<button class=\"ds-btn ds-primary\" type=\"button\">Entrar</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:44px;border:1px solid transparent;border-radius:6px;padding:10px 16px;font-size:14px;font-weight:600;line-height:1.5;cursor:pointer;font-family:\"Segoe UI\",-apple-system,BlinkMacSystemFont,Arial,sans-serif;}.ds-btn:disabled{cursor:wait;opacity:.65;}.ds-btn:focus-visible{outline:3px solid var(--focus,#2563eb);outline-offset:4px;}.ds-primary{background:var(--primary,#2459ca);color:var(--surface,#ffffff);}.ds-primary:hover:not(:disabled){background:var(--primary-hover,#1746ab);}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "A separated session-ending action.",
      "html": "<button class=\"ds-btn ds-outline\" type=\"button\">Sair da conta</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:44px;border:1px solid transparent;border-radius:6px;padding:10px 16px;font-size:14px;font-weight:600;line-height:1.5;cursor:pointer;font-family:\"Segoe UI\",-apple-system,BlinkMacSystemFont,Arial,sans-serif;}.ds-btn:disabled{cursor:wait;opacity:.65;}.ds-btn:focus-visible{outline:3px solid var(--focus,#2563eb);outline-offset:4px;}.ds-outline{background:transparent;color:var(--ink,#14243b);border-color:var(--line,#b7c6d9);}.ds-outline:hover:not(:disabled){background:var(--notice-ground,#e9f2ff);}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "A quiet masthead action; the surrounding band is part of this preview context.",
      "html": "<div class=\"ds-ghost-band\"><button class=\"ds-btn ds-ghost\" type=\"button\" aria-label=\"Alternar tema claro e escuro\">Tema</button></div>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:44px;border:1px solid transparent;border-radius:6px;padding:10px 16px;font-size:14px;font-weight:600;line-height:1.5;cursor:pointer;font-family:\"Segoe UI\",-apple-system,BlinkMacSystemFont,Arial,sans-serif;}.ds-btn:disabled{cursor:wait;opacity:.65;}.ds-btn:focus-visible{outline:3px solid var(--focus,#2563eb);outline-offset:4px;}.ds-ghost-band{padding:16px;background:var(--header,#142c4d);}.ds-ghost{background:transparent;color:var(--header-text,#f3f7ff);}.ds-ghost:hover:not(:disabled){background:#7b9cc226;}.ds-ghost:focus-visible{outline-color:#c0d2ec;}"
    },
    {
      "name": "Labeled Input",
      "kind": "input",
      "refersTo": "input",
      "description": "An explicit label and comfortable field with keyboard and invalid states.",
      "html": "<div class=\"ds-field\"><label class=\"ds-label\" for=\"ds-email\">E-mail</label><input class=\"ds-input\" id=\"ds-email\" type=\"email\" placeholder=\"nome@empresa.com.br\" autocomplete=\"username\"></div>",
      "css": ".ds-field{font-family:\"Segoe UI\",-apple-system,BlinkMacSystemFont,Arial,sans-serif;color:var(--ink,#14243b);}.ds-label{display:block;margin-bottom:8px;font-size:14px;font-weight:600;line-height:1.5;}.ds-input{display:block;width:100%;min-height:48px;padding:10px 12px;border:1px solid var(--line,#b7c6d9);border-radius:6px;background:var(--surface,#ffffff);color:var(--ink,#14243b);caret-color:var(--primary,#2459ca);font-size:16px;line-height:1.5;font-family:\"Segoe UI\",-apple-system,BlinkMacSystemFont,Arial,sans-serif;}.ds-input::placeholder{color:var(--muted,#52657e);opacity:1;}.ds-input[aria-invalid=\"true\"]{border-color:var(--error,#a72336);}.ds-input:focus-visible{outline:3px solid var(--focus,#2563eb);outline-offset:4px;}"
    },
    {
      "name": "Working Surface",
      "kind": "card",
      "refersTo": "working-surface",
      "description": "The flat bounded container used by identity tasks, without shadow elevation.",
      "html": "<section class=\"ds-surface\"><h1 class=\"ds-heading\">Minha conta</h1><p class=\"ds-intro\">Voc\u00ea est\u00e1 conectado ao Altvia Workspace.</p></section>",
      "css": ".ds-surface{width:100%;max-width:440px;padding:36px;border:1px solid var(--line,#b7c6d9);border-radius:12px;background:var(--surface,#ffffff);color:var(--ink,#14243b);font-family:\"Segoe UI\",-apple-system,BlinkMacSystemFont,Arial,sans-serif;}.ds-heading{margin:0 0 10px;font-size:28px;font-weight:650;line-height:1.2;letter-spacing:-.025em;text-wrap:balance;}.ds-intro{margin:0 0 32px;color:var(--muted,#52657e);font-size:16px;line-height:1.5;}@media(max-width:540px){.ds-surface{padding:28px 24px;}.ds-heading{font-size:26px;}}"
    },
    {
      "name": "Masthead Location",
      "kind": "custom",
      "description": "The text identity and current-place marker; this is not a navigation menu.",
      "html": "<header class=\"ds-masthead\"><div class=\"ds-brand\">Altvia <span>Workspace</span></div><span class=\"ds-location\"><span class=\"ds-dot\"></span>Acesso</span></header>",
      "css": ".ds-masthead{display:flex;align-items:center;gap:24px;min-height:80px;padding:16px clamp(20px,5vw,72px);background:var(--header,#142c4d);color:var(--header-text,#f3f7ff);font-family:\"Segoe UI\",-apple-system,BlinkMacSystemFont,Arial,sans-serif;}.ds-brand{font-size:24px;font-weight:700;letter-spacing:-.025em;white-space:nowrap;}.ds-brand span{font-weight:400;}.ds-location{display:flex;align-items:center;gap:8px;padding-left:24px;border-left:1px solid #5c7596;color:var(--header-muted,#c0d2ec);font-size:14px;line-height:1.5;}.ds-dot{width:6px;height:6px;background:#a7c6ff;border-radius:50%;}@media(max-width:540px){.ds-masthead{min-height:72px;gap:12px;padding:14px 20px;flex-wrap:wrap;}.ds-brand{font-size:20px;}.ds-location{order:3;width:100%;border:0;padding:0;}}"
    },
    {
      "name": "Session Notice",
      "kind": "custom",
